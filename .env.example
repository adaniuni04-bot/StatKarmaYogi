ENVIRONMENT=production
SECRET_KEY=gov-stat-skill-intelligence-secret-key-2026-super-secure
JWT_SECRET=gov-stat-jwt-secret-key-super-secure-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite+pysqlite:///./stat_skills.db
VECTOR_DIMENSION=1024

DEMO_MODE=false
IGOT_MODE=live
NSSTA_MODE=live

# ============================================================
# AI & LLM Cloud Configuration (Groq Cloud Console)
# ============================================================
# Free Groq API Key: https://console.groq.com/keys
# Once you add your key below, all AI evaluation & tutor features
# will run at ultra-fast speeds directly from the cloud without
# needing any local Ollama process or local GPU!
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=mock

# PASTE YOUR GROQ API KEY HERE (starts with gsk_):
GROQ_API_KEY=

# Groq API Base URL & Model (Default: Qwen 3.8 / Qwen 2.5)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
# Alternative models on Groq: qwen-2.5-32b, qwen-2.5-coder-32b, llama-3.3-70b-versatile

# (Optional) Local Ollama Fallback if ever needed
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3:latest

UPLOAD_MAX_MB=25
ALLOWED_EXTENSIONS=pdf,docx,pptx,txt

WEIGHT_SELF_ASSESSMENT=0.10
WEIGHT_KNOWLEDGE_ASSESSMENT=0.35
WEIGHT_PRACTICAL_ASSESSMENT=0.40
WEIGHT_TRAINING_EVIDENCE=0.15

WEIGHT_SKILL_GAP=0.35
WEIGHT_ROLE_RELEVANCE=0.20
WEIGHT_DIFFICULTY_SUITABILITY=0.15
WEIGHT_LEARNING_HISTORY=0.10
WEIGHT_CAREER_RELEVANCE=0.10
WEIGHT_DEPARTMENT_PRIORITY=0.05
WEIGHT_FRESHNESS=0.05
