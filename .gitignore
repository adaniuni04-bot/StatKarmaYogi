# ============================================================
# StatKarmaYogi Platform - Git Ignore Configuration
# ============================================================

# Node.js & Frontend Dependencies (regenerated via 'npm install' or 'install_dependencies.bat')
node_modules/
frontend/node_modules/
/.pnp
.pnp.js

# Next.js Build Output & Caches
.next/
frontend/.next/
out/
frontend/out/
build/
dist/

# Python Cache & Bytecode
__pycache__/
backend/**/__pycache__/
*.py[cod]
*.class
*.so
.Python
env/
venv/
.venv/

# Database Files & Logs
stat_skills.db
backend/stat_skills.db
stat_skills.db-journal
backend/stat_skills.db-journal
*.log

# Secret Environment Files (prevents accidental public API key leak on GitHub)
.env
backend/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
